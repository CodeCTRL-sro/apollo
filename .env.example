# ---------------------------------------------------------------------------
# Apollo – environment variables
#
# Copy to .env and fill in. Every key read by the framework is listed here;
# keys marked REQUIRED are validated at boot by Env::assertRequired().
#
# Read them through CodeCTRL\Apollo\Core\Env, never $_ENV directly:
#   Env::string('CRYPT_SECRET');        // required, throws when unset
#   Env::int('MAIL_SMTP_PORT', 587);    // optional with a default
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------

# Turns on display_errors, the Whoops error page and verbose stack traces.
# MUST be false in production: with it on, exception messages and traces are
# rendered into the error page.
APP_DEBUG=false

# --- Encryption (CryptHelper) ---------------------------------------------

# REQUIRED when CryptHelper is used. 32 bytes, base64 encoded.
# Generate one with:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32)), PHP_EOL;"
#
# A plain (non base64:) value is still accepted for backwards compatibility,
# but it must be exactly 32 bytes long.
CRYPT_SECRET=

# Optional cipher override. Defaults to aes-256-gcm (authenticated).
# Only set this if you know why; aes-256-ecb is accepted for reading legacy
# payloads but is refused for new ones.
#CRYPT_ALGO=aes-256-gcm

# --- Mail (MailHelper) -----------------------------------------------------

# REQUIRED when mail is sent.
MAIL_ADDRESS=
MAIL_NAME=

# SMTP transport. Leave MAIL_SMTP_HOST empty to use PHP's mail().
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_AUTH=true
# tls | ssl
MAIL_SMTP_ENCRYPTION=tls
# Set to XOAUTH2 when authenticating through Google OAuth below.
#MAIL_SMTP_AUTH_TYPE=

# Google OAuth2 for SMTP. Set all three to enable; MAIL_SMTP_USER is used as
# the OAuth user name.
#MAIL_GOOGLE_CLIENT_ID=
#MAIL_GOOGLE_CLIENT_SECRET=
#MAIL_GOOGLE_REFRESH_TOKEN=

# --- Bunny CDN (BunnyCDNHelper) -------------------------------------------

#BUNNY_CDN_SECRET=
#BUNNY_CDN_STORAGE_ZONE=
#BUNNY_CDN_PULL_ZONE_HOSTNAME=

# --- Profanity filter (ProfanityHelper) -----------------------------------

# Absolute path to a PHP file returning an array of words.
#PROFANITIES_PATH=

# --- Uploads (ImageHelper) -------------------------------------------------

# Memory ceiling while processing an uploaded image. Previously this was
# hardcoded to -1 (unlimited), which let a single oversized upload exhaust the
# worker. Use a PHP shorthand size, or -1 to restore the old behaviour.
IMAGE_MEMORY_LIMIT=512M

# Reject uploads whose pixel count exceeds this before decoding them.
IMAGE_MAX_PIXELS=40000000

# JPEG quality for saved uploads. 98 matches what the previous GD re-encode used.
IMAGE_JPEG_QUALITY=98
