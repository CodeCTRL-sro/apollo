includes:
    # Existing findings are frozen here rather than suppressed by pattern. The previous
    # config carried blanket ignores such as '#PHPDoc tag @var#', which silenced whole
    # categories of error across the codebase — including ones that had not been written
    # yet. PHPStan reported most of those patterns as never matching anything at all.
    #
    # With a baseline, current findings stay quiet but any NEW one fails the build, and
    # `vendor/bin/phpstan analyse --generate-baseline` shows exactly how much is left.
    - phpstan-baseline.neon

parameters:
    level: 5

    paths:
        - src/
        - tests/

    bootstrapFiles:
        - phpstan-bootstrap.php

    # A great many properties here are documented only in @var/@property docblocks. Taking
    # those as certain turns every such declaration into a cascade of follow-up errors
    # about impossible comparisons.
    treatPhpDocTypesAsCertain: false
